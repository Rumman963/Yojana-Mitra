

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SchemeLevel {
  CENTRAL
  STATE
}

enum JurisdictionType {
  STATE
  UNION_TERRITORY
}

enum SchemeCategory {
  EDUCATION
  AGRICULTURE
  HEALTH
  HOUSING
  EMPLOYMENT
  WOMEN_AND_CHILD
  PENSION
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SocialCategory {
  GENERAL
  OBC
  SC
  ST
}

model Scheme {
  id             Int           @id        @default(autoincrement())
  slug           String        @unique
                 
  level          SchemeLevel
  state          String?
  category       SchemeCategory
      
  nameEn         String
  nameHi         String?
  descriptionEn  String
  descriptionHi  String?
  benefitEn      String
  benefitHi      String?
  howToApplyEn   String?
  howToApplyHi   String?
  otherConditionsEn String[]

  officialUrl    String
  lastVerifiedAt DateTime

  minAge           Int?
  maxAge           Int?
  gender           Gender?
  maxAnnualIncome  Int?
  socialCategories SocialCategory[]
  occupations      String[]
  documents        Document[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Jurisdiction {
  id           Int              @id @default(autoincrement())
  lgdCode      Int              @unique
  nameEn       String           @unique
  nameHi       String?
  type         JurisdictionType
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}


model Document {
  id     Int      @id       @default(autoincrement())
  key    String   @unique
  nameEn String
  nameHi String?

  schemes Scheme[]
}
